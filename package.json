{
  "name": "social-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Social Pro — Agency social media management SaaS",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @social-pro/prisma generate",
    "db:migrate": "pnpm --filter @social-pro/prisma migrate:dev",
    "db:seed": "pnpm --filter @social-pro/prisma seed",
    "db:studio": "pnpm --filter @social-pro/prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.8.17"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
