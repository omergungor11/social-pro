# ============================================
# Social Pro Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ----- Database -----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_pro_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_pro_dev

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- JWT -----
JWT_SECRET=your-jwt-secret-min-32-chars-change-in-prod
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- App -----
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ----- S3 / MinIO -----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=social-pro-media
S3_REGION=us-east-1

# ----- Email (SMTP) -----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@socialpro.dev

# ----- Stripe -----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ----- AI Providers -----
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ----- OAuth: Twitter/X -----
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:4000/api/v1/social-accounts/twitter/callback

# ----- OAuth: Facebook/Instagram (Meta) -----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/v1/social-accounts/facebook/callback

# ----- OAuth: LinkedIn -----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:4000/api/v1/social-accounts/linkedin/callback

# ----- OAuth: TikTok -----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=http://localhost:4000/api/v1/social-accounts/tiktok/callback

# ----- OAuth: YouTube/Google -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/social-accounts/youtube/callback

# ----- Token Encryption -----
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-change-in-prod

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
