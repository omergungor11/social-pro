# ============================================
# Social Pro Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# VERCEL DEPLOYMENT NOTES:
# - Frontend runs on Vercel (uses NEXT_PUBLIC_* variables)
# - Backend runs on Railway.app (or Render/Fly.io)
# - Set NEXT_PUBLIC_* variables in Vercel Environment Variables
# - Set other variables in backend deployment platform

# ----- Database -----
# Local: PostgreSQL
# Production: Use managed service (Railway, AWS RDS, DigitalOcean, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_pro_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_pro_dev

# ----- Redis -----
# Local: Docker compose (redis service)
# Production: Use managed service (Railway, AWS ElastiCache, Upstash, etc.)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Alternative format (some platforms use URL):
# REDIS_URL=redis://localhost:6379

# ----- JWT -----
# Generate strong random values for production
# Minimum 32 characters recommended
JWT_SECRET=your-jwt-secret-min-32-chars-change-in-prod
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- App -----
PORT=4000
API_URL=http://localhost:4000
# PRODUCTION: Set to your deployed API URL (e.g., https://api.socialpro.railway.app)

CORS_ORIGIN=http://localhost:3000
# PRODUCTION: Set to your Vercel frontend URL (e.g., https://socialpro.vercel.app)

NODE_ENV=development

# ----- S3 / Object Storage -----
# Local: MinIO via Docker compose
# Production: AWS S3, DigitalOcean Spaces, or MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=social-pro-media
S3_REGION=us-east-1

# For AWS S3:
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key
# S3_REGION=us-east-1

# ----- Email (SMTP) -----
# Local: MailHog via Docker compose (localhost:1025)
# Production: SendGrid, AWS SES, Resend, etc.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@socialpro.dev

# For Resend (recommended):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=your-resend-api-key

# ----- Stripe -----
# Get keys from: https://dashboard.stripe.com/apikeys
# Use TEST keys locally, LIVE keys in production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ----- AI Providers -----
# Get keys from respective provider dashboards
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ----- OAuth: Twitter/X -----
# Register app: https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:4000/api/v1/social-accounts/twitter/callback
# PRODUCTION: Update callback URL to deployed backend

# ----- OAuth: Facebook/Instagram (Meta) -----
# Register app: https://developers.facebook.com/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/v1/social-accounts/facebook/callback
# PRODUCTION: Update callback URL to deployed backend

# ----- OAuth: LinkedIn -----
# Register app: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:4000/api/v1/social-accounts/linkedin/callback
# PRODUCTION: Update callback URL to deployed backend

# ----- OAuth: TikTok -----
# Register app: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=http://localhost:4000/api/v1/social-accounts/tiktok/callback
# PRODUCTION: Update callback URL to deployed backend

# ----- OAuth: YouTube/Google -----
# Register app: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/social-accounts/youtube/callback
# PRODUCTION: Update callback URL to deployed backend

# ----- Token Encryption -----
# Generate random 32-byte hex: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-change-in-prod

# ============================================
# Frontend (Next.js) — NEXT_PUBLIC_* ONLY
# ============================================
# These are embedded in frontend bundle — only use for non-sensitive data
# Set in Vercel Environment Variables for production

# Local development API endpoint
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# PRODUCTION: Set in Vercel to https://api.socialpro.railway.app/api/v1

# Frontend app URL (for links, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PRODUCTION: Set in Vercel to https://socialpro.vercel.app

# Stripe public key (safe to expose, can't charge without private key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# PRODUCTION: Set in Vercel to your Stripe LIVE public key
